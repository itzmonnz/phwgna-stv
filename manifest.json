{
  "manifest_version": 3,
  "name": "Phwgna Stv",
  "version": "0.2.8",
  "description": "Dịch chương Sáng Tác Việt qua ChatGPT, Gemini hoặc API do người dùng chọn.",
  "icons": {
    "16": "assets/icons/phwgna-cat-16.png",
    "32": "assets/icons/phwgna-cat-32.png",
    "48": "assets/icons/phwgna-cat-48.png",
    "128": "assets/icons/phwgna-cat-128.png"
  },
  "permissions": [
    "storage",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "https://fanqienovel.com/*",
    "https://sangtacviet.app/*",
    "https://sangtacviet.com/*",
    "https://sangtacviet.vip/*",
    "http://sangtacviet.com/*",
    "http://14.225.254.182/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://translate.googleapis.com/*",
    "https://moxhi.vietphrase.app/*",
    "https://api.mymemory.translated.net/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://raw.githubusercontent.com/itzmonnz/phwgna-stv-updates/*",
    "https://accounts.google.com/SignOutOptions*",
    "https://www.qidian.com/*",
    "https://qidian.com/*",
    "https://my.qidian.com/author/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Phwgna Stv",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/phwgna-cat-16.png",
      "32": "assets/icons/phwgna-cat-32.png",
      "48": "assets/icons/phwgna-cat-48.png",
      "128": "assets/icons/phwgna-cat-128.png"
    }
  },
  "options_page": "options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared/fanqie-title-data/index.json",
        "src/shared/fanqie-title-data/0.json",
        "src/shared/fanqie-title-data/1.json",
        "src/shared/fanqie-title-data/2.json",
        "src/shared/fanqie-title-data/3.json",
        "src/shared/fanqie-title-data/4.json",
        "src/shared/fanqie-title-data/5.json",
        "src/shared/fanqie-title-data/6.json",
        "src/shared/fanqie-title-data/7.json",
        "src/shared/fanqie-title-data/8.json",
        "src/shared/fanqie-title-data/9.json",
        "src/shared/fanqie-title-data/10.json",
        "src/shared/fanqie-title-data/font-library.json",
        "src/shared/fanqie-title-data/font-search.json",
        "src/shared/fanqie-title-data/font-home.json",
        "src/content/stv.css",
        "assets/icons/phwgna-cat-128.png"
      ],
      "matches": [
        "https://fanqienovel.com/*"
      ]
    },
    {
      "resources": [
        "assets/icons/phwgna-cat-128.png"
      ],
      "matches": [
        "https://sangtacviet.app/*",
        "https://sangtacviet.com/*",
        "https://sangtacviet.vip/*",
        "http://sangtacviet.com/*",
        "http://14.225.254.182/*"
      ]
    },
    {
      "resources": [
        "src/content/stv.css",
        "assets/icons/phwgna-cat-128.png"
      ],
      "matches": [
        "https://www.qidian.com/*",
        "https://qidian.com/*",
        "https://my.qidian.com/author/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fanqienovel.com/*",
        "https://sangtacviet.app/*",
        "https://sangtacviet.com/*",
        "https://sangtacviet.vip/*",
        "http://sangtacviet.com/*",
        "http://14.225.254.182/*",
        "https://www.qidian.com/*",
        "https://qidian.com/*",
        "https://my.qidian.com/author/*"
      ],
      "js": [
        "src/content/site-translation-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://moxhi.vietphrase.app/*"
      ],
      "js": [
        "src/content/hachimi-provider.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fanqienovel.com/*"
      ],
      "js": [
        "src/shared/fanqie-ui-dictionary.js",
        "src/shared/fanqie-title-translator.js",
        "src/shared/fanqie-preferences.js",
        "src/shared/branding.js",
        "src/vendor/gsap.min.js",
        "src/content/stv-motion.js",
        "src/content/stv-ui.js",
        "src/content/stv-name-manager.js",
        "src/content/fanqie-book-preview.js",
        "src/content/fanqie-ui.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sangtacviet.app/*",
        "https://sangtacviet.com/*",
        "https://sangtacviet.vip/*",
        "http://sangtacviet.com/*",
        "http://14.225.254.182/*"
      ],
      "js": [
        "src/shared/stv-sites.js",
        "src/shared/native-history.js",
        "src/shared/native-portable.js",
        "src/content/stv-account.js",
        "src/content/stv-history.js",
        "src/content/stv-portable.js",
        "src/content/stv-diagnostics.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://sangtacviet.app/*",
        "https://sangtacviet.com/*",
        "https://sangtacviet.vip/*",
        "http://sangtacviet.com/*",
        "http://14.225.254.182/*"
      ],
      "js": [
        "src/shared/tts-pronunciation.js",
        "src/content/stv-ui.js",
        "src/content/stv-site-navigation.js"
      ],
      "css": [
        "src/content/stv.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sangtacviet.app/truyen/*",
        "https://sangtacviet.com/truyen/*",
        "https://sangtacviet.vip/truyen/*",
        "http://sangtacviet.com/truyen/*",
        "http://14.225.254.182/truyen/*"
      ],
      "js": [
        "src/shared/stv-sites.js",
        "src/shared/core.js",
        "src/shared/tts-pronunciation.js",
        "src/shared/branding.js",
        "src/shared/name-aliases.js",
        "src/content/stv-extractor.js",
        "src/content/stv-diagnostics.js",
        "src/vendor/gsap.min.js",
        "src/content/stv-motion.js",
        "src/content/stv-ui.js",
        "src/content/stv-name-editor.js",
        "src/content/stv-name-manager.js",
        "src/content/stv-tts-client.js",
        "src/content/stv-prefetch.js",
        "src/content/stv.js"
      ],
      "css": [
        "src/content/stv.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sangtacviet.app/truyen/*",
        "https://sangtacviet.com/truyen/*",
        "https://sangtacviet.vip/truyen/*",
        "http://sangtacviet.com/truyen/*",
        "http://14.225.254.182/truyen/*"
      ],
      "js": [
        "src/shared/stv-sites.js",
        "src/shared/tts-pronunciation.js",
        "src/content/stv-tts-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/content/provider-common.js",
        "src/content/gemini-dom-resolver.js",
        "src/content/chatgpt-dom-resolver.js",
        "src/content/chatgpt.js",
        "src/content/provider-diagnostics.js"
      ],
      "css": [
        "src/content/chatgpt-performance.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/content/gemini-account-probe.js",
        "src/shared/core.js",
        "src/content/provider-common.js",
        "src/content/gemini-dom-resolver.js",
        "src/content/gemini.js",
        "src/content/provider-diagnostics.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://accounts.google.com/SignOutOptions*"
      ],
      "js": [
        "src/content/gemini-account-probe.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.qidian.com/*",
        "https://qidian.com/*",
        "https://my.qidian.com/author/*"
      ],
      "js": [
        "src/shared/qidian-sites.js",
        "src/shared/fanqie-preferences.js",
        "src/shared/branding.js",
        "src/vendor/gsap.min.js",
        "src/content/stv-motion.js",
        "src/content/stv-ui.js",
        "src/content/stv-name-manager.js",
        "src/content/fanqie-book-preview.js",
        "src/content/qidian-book-preview.js",
        "src/content/qidian-ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
